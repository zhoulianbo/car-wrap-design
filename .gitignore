# dependencies
/node_modules
/.pnpm-store/
/tmp
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# tanstack start / vite / nitro
/.next/
/.output/
/.nitro/
/.tanstack/
/.vite/
/.cache/
/dist/
src/routeTree.gen.ts
src/paraglide/

# generated tool files (keep Inlang settings and project Git hooks)
/project.inlang/cache/
/.husky/_/

# Cloudflare local state and runtime secrets (wrangler.jsonc contains no secrets).
/.wrangler/
.dev.vars
.dev.vars.*

# claude code local state
.claude/scheduled_tasks.lock
/.claude/settings.local.json
/.claude/worktrees/

# production
/build

# deploy
.vercel

# editors (keep .cursor/skills — cross-agent symlink to .claude/skills)
.idea
.vscode
.cursor/*
!.cursor/skills

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
*.log

# generated test coverage and browser reports
/coverage/
/playwright-report/
/test-results/

# env — local files hold secrets, never commit (keep .env.example tracked)
.env
.env.*
!.env.example

# typescript
*.tsbuildinfo

# database
/data/
# Commit Drizzle migrations so Cloudflare/Git checkouts can apply the schema.
src/config/db/schema.ts

# npm (project uses pnpm)
package-lock.json

# Runtime image uploads (no-storage local fallback)
/public/uploads/
/public/models/

# SEO skill working cache (generated locally, never committed)
/.seo-cache/
